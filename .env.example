# Template per .env.local (copialo con `cp .env.example .env.local` e riempi i valori).
# Il file .env.local e' gitignored: le chiavi vere non finiscono mai nel repo.

# ---------------------------------------------------------------------------
# Commenti AI (e DM AI sul branch personalcoaching)
# ---------------------------------------------------------------------------
# Bearer token dello HuggingFace Space che genera i commenti.
# Space: https://huggingface.co/spaces/mattysaints/instagram_bot
# Il valore e' il SPACE_API_KEY salvato nei Secrets dello Space stesso.
#
# Se lasci il placeholder, i commenti AI non partono e il bot cade
# automaticamente sul fallback comments_list.txt (nessun crash).
export IG_COMMENT_SPACE_KEY="YOUR_SPACE_API_KEY_HERE"
